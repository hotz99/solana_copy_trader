MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
DEVNET_RPC_URL=https://api.devnet.solana.com
DEVNET_WSS_URL=wss://api.devnet.solana.com

# Wallet credentials (base58-encoded)
PRIVATE_KEY=
PUBLIC_KEY=

# Bot configuration
BOT_MODE=COPY            # COPY | SELLING
SOURCE_ADDRESS=          # wallet to copy
TRADE_TYPE=EXACT         # EXACT | SAFE
BUY_AMOUNT=0.1           # SOL per buy
TAKE_PROFIT=1.05
STOP_LOSS=0.95
SLIPPAGE_BP=50
JITO_TIP=0.001
JITO_ENGINE=

COINVERA_API_KEY=

# Timing & routing
PRICE_CHECK_DELAY_MS=500
PREFERRED_DEX=auto       # none | auto | pumpfun | meteora | raydium | moonshot | jupiter
ENABLE_MULTI_BUY=true
